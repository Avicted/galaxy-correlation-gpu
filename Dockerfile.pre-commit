# syntax=docker/dockerfile:1

# Image that runs the pre-commit hooks with every tool present as a system
# binary, at the exact pinned version.
#
# Deliberately CUDA-free, and ~250 MB rather than the ~6 GB of the CUDA
# development image. That is the point of the split: Makefile.pre-commit holds
# the checks that must run where there is no GPU toolchain, and this image
# proves they do. `make tidy` is the one check that needs CUDA headers; it
# lives in ./Dockerfile instead and skips cleanly here.
#
# Build:  make pre-commit-build
# Run:    make pre-commit
#
# Keep the ARG versions in sync with the *_VERSION values in
# Makefile.pre-commit - `make -f Makefile.pre-commit tools STRICT=1` is what
# catches drift.

FROM debian:bookworm-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG PRE_COMMIT_VERSION=4.6.2
ARG CLANG_FORMAT_VERSION=22.1.8
ARG SHELLCHECK_VERSION=0.10.0
ARG HADOLINT_VERSION=2.12.0
ARG GITLEAKS_VERSION=8.24.0

# shellcheck and hadolint come from pinned release tarballs rather than apt:
# Debian's versions drift between rebuilds, and a linter that changes its
# verdict without the code changing is worse than no linter.
# hadolint ignore=DL3008
RUN <<EOF
    set -euo pipefail
    apt-get update
    apt-get install --no-install-recommends -y \
        bash \
        ca-certificates \
        curl \
        git \
        make \
        python3 \
        python3-pip \
        xz-utils

    pip3 install --break-system-packages --no-cache-dir \
        "pre-commit==${PRE_COMMIT_VERSION}" \
        "clang-format==${CLANG_FORMAT_VERSION}"

    curl -fsSL "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.x86_64.tar.xz" \
        | tar -xJ --strip-components=1 -C /usr/local/bin "shellcheck-v${SHELLCHECK_VERSION}/shellcheck"

    curl -fsSL -o /usr/local/bin/hadolint \
        "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-x86_64"

    chmod +x /usr/local/bin/hadolint
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
        | tar -xz -C /usr/local/bin gitleaks

    apt-get clean
    rm -rf /var/lib/apt/lists/*
    git config --global --add safe.directory /src
EOF

WORKDIR /src

ENTRYPOINT ["pre-commit"]
CMD ["run", "--all-files"]
